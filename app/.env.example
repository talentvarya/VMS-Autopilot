# VMS Autopilot - environment variable TEMPLATE.
# Copy to .env.local and fill in YOURSELF. Never commit .env.local, never paste real
# values into chat, and never use production credentials while developing.
#
# src/lib/config/staging-env-spec.ts describes the shape each one must have, and
# src/lib/config/env-validation.ts can check a deployment against that shape - without ever
# reading or exposing the real value. Most of these still aren't read by any running code path
# (Supabase, Meta). ANTHROPIC_API_KEY/ANTHROPIC_MODEL ARE read (src/lib/ai/anthropic-client.ts).
# Phase F.3 approved and enabled the real AI caption path (LIVE_SOCIAL_CAPTION_AI_ENABLED = true,
# src/lib/agents/social/caption-ai-provider.ts), but it still only ever reaches a real call in
# staging or production (never development or test), AND only once this key is actually
# configured there - setting this key alone, or being in staging alone, is still not enough.

# Which environment tier this deployment is. See src/lib/config/environment.ts.
APP_ENV=development

# Supabase - browser-safe values (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase - SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
# Never expose to the browser and never give to a client user.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider. Phase F.3 approved and enabled the real AI caption path for staging
# (LIVE_SOCIAL_CAPTION_AI_ENABLED = true) - it is only live where BOTH this key is configured
# AND the deployment's APP_ENV is staging or production (never development or test, whatever
# this is set to locally). Never paste a real key into this file or into chat - you create it
# yourself in the provider's console and type it directly into Vercel's Staging environment
# settings, never here.
ANTHROPIC_API_KEY=
# Optional model override - defaults to claude-sonnet-5-5 if unset.
ANTHROPIC_MODEL=

# Meta OAuth - NOT required or read by any code yet. Only listed here so its shape is agreed
# on before the Meta OAuth sub-phase is approved and built. Same rule: never pasted, never typed
# by anyone but you.
META_APP_ID=
META_APP_SECRET=
