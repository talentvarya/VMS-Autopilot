# VMS Autopilot - environment variable TEMPLATE.
# Copy to .env.local and fill in YOURSELF. Never commit .env.local, never paste real
# values into chat, and never use production credentials while developing.
#
# The application code still does not read any of these yet. src/lib/config/staging-env-spec.ts
# describes the shape each one must have, and src/lib/config/env-validation.ts can check a
# deployment against that shape - without ever reading or exposing the real value - once a
# later Phase F step actually wires a startup check up to it.

# Which environment tier this deployment is. See src/lib/config/environment.ts.
APP_ENV=development

# Supabase - browser-safe values (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase - SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
# Never expose to the browser and never give to a client user.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider - NOT required or read by any code yet. Only listed here so its shape is agreed
# on before the AI-provider integration sub-phase is approved and built. Never paste a real
# key into this file or into chat - you create it yourself in the provider's console and type
# it directly into the secret store when that sub-phase is approved.
ANTHROPIC_API_KEY=

# Meta OAuth - NOT required or read by any code yet. Only listed here so its shape is agreed
# on before the Meta OAuth sub-phase is approved and built. Same rule: never pasted, never typed
# by anyone but you.
META_APP_ID=
META_APP_SECRET=
